# ============================================================
#  Modelo de configuração — copie para .env e ajuste
#  cp .env.exemplo .env
# ============================================================

# "local" = banco desta máquina | "producao" = banco externo
AMBIENTE=local

# Banco local (desenvolvimento)
DATABASE_URL_LOCAL=postgresql://sistemax:sistemax@127.0.0.1:5433/sistemax

# Banco externo (ex.: Render, Neon, servidor da escola)
DATABASE_URL_PRODUCAO=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# Porta do site
PORT=3000

# Segredo das sessões (troque por algo longo e secreto)
SESSION_SECRET=troque-este-segredo-por-algo-unico-e-longo

# URL pública do site (usada nos links e no retorno do login social)
SITE_URL=http://localhost:3000

# ============================================================
#  Login social (OAuth) — opcional
#  Sem estas variáveis os botões mostram "ainda não configurado".
#  Veja o passo a passo em COMO-CONFIGURAR-LOGIN-SOCIAL.md
# ============================================================

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: sobrescreve a URL de retorno montada a partir de SITE_URL
# GOOGLE_REDIRECT_URI=http://localhost:3000/entrar/google/callback
# GITHUB_REDIRECT_URI=http://localhost:3000/entrar/github/callback

# ============================================================
#  PRODUÇÃO (Render, Vercel ou servidor próprio + PostgreSQL externo)
#  Configure estas variáveis no painel da hospedagem — nunca no repositório.
#  No Render, use o render.yaml (banco incluído) ou preencha DATABASE_URL.
# ============================================================
# AMBIENTE=producao
#
# Banco: use a URL do PostgreSQL externo (Render, Neon, Supabase...).
# Na Neon/Supabase prefira a URL "pooled" (com -pooler), ideal para serverless.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
# PG_SSL=true
#
# No Render com banco interno, a conexão não usa SSL:
# PG_SSL=false
#
# Segredo forte (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=
#
# Endereço público, sem barra no final (ex.: https://nuvia.onrender.com)
# SITE_URL=https://SEU-PROJETO.onrender.com
#
# Primeiro administrador (criado automaticamente no primeiro acesso).
# Só é criado se ainda não existir nenhum admin. Senha com 8+ caracteres.
# ADMIN_EMAIL=admin@suaescola.com
# ADMIN_SENHA=
# ADMIN_NOME=Administrador
#
# Nunca use os dados de exemplo em produção:
# SEED_DEMO=false
#
# Limite de upload por entrega em MB. A Vercel aceita ~4,5 MB por requisição.
# LIMITE_ENTREGA_MB=4
